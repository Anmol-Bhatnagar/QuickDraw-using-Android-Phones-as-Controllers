<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- Persistent Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E293B"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="⌂ HOME"
            android:textColor="#38BDF8"
            android:textStyle="bold"
            android:backgroundTint="#334155"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⭐ TILT MAZE"
            android:textColor="#FACC15"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtPlayerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P1"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:background="#FACC15"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#FACC15" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Instruction / Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center">

            <TextView
                android:id="@+id/txtTiltStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TILT PHONE TO ROLL"
                android:textColor="#38BDF8"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txtSensorStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roll: 0° | Pitch: 0°"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Giant Jump Button -->
        <Button
            android:id="@+id/btnJump"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="🦘 HOP / JUMP\n(OR SHAKE PHONE)"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:backgroundTint="#F59E0B"
            android:layout_marginBottom="18dp" />

        <!-- Calibrate Button -->
        <Button
            android:id="@+id/btnCalibrate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🔄 CALIBRATE NEUTRAL TILT"
            android:textColor="#E2E8F0"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="#334155" />

    </LinearLayout>

</LinearLayout>
