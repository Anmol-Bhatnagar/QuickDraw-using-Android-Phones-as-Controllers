<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#10121A">

    <!-- Persistent Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1B1D28"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="⌂ HOME"
            android:textColor="#00D2FF"
            android:textStyle="bold"
            android:backgroundTint="#2E334D"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎾 TENNIS RACQUET"
            android:textColor="#7FE3FF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtPlayerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#0077FF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#7FE3FF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <!-- Swing Meter Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1D2B"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SWING VELOCITY SENSOR"
                android:textColor="#8899BB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtSwingEnergy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY TO SWING"
                android:textColor="#7FE3FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/barEnergy"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:max="100"
                android:progress="0"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏸 Swing your phone like a tennis racquet!\nTilt left or right during swing to place the shot."
            android:textColor="#A0B0D0"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="24dp" />

        <!-- Manual Swing / Strike Button -->
        <Button
            android:id="@+id/btnSwing"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="🎾 TAP OR SWING PHONE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:backgroundTint="#0077EE"
            android:layout_marginBottom="12dp" />

        <!-- Calibrate Button -->
        <Button
            android:id="@+id/btnCalibrate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔄 CALIBRATE AIM"
            android:textColor="#CCCCCC"
            android:textStyle="bold"
            android:backgroundTint="#252837" />

    </LinearLayout>

</LinearLayout>
