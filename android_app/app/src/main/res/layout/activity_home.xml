<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12131C"
    android:padding="16dp">

    <!-- Top Connection & Role Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎮 GAME CONSOLE"
            android:textColor="#00D2FF"
            android:textStyle="bold"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnRoleToggle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="P1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#0077FF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnServerIp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="⚙ IP"
            android:textColor="#CCCCCC"
            android:backgroundTint="#252837"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

    </LinearLayout>

    <!-- Connection Status -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connecting..."
        android:textColor="#888888"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E334D"
        android:layout_marginBottom="16dp" />

    <!-- Center Carousel Card -->
    <LinearLayout
        android:id="@+id/cardGame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#1A1D2B"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtGameBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME 1 OF 20"
            android:textColor="#FFD166"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="#2E334D"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txtGameIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤠"
            android:textSize="64sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtGameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICKDRAW"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="26sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/txtGameDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wild West Outlaw Duel! Holster phone, listen, and draw on target word."
            android:textColor="#A0B0D0"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

    <!-- Bottom Carousel Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="◀ PREV"
            android:textColor="#EEEEEE"
            android:textStyle="bold"
            android:backgroundTint="#252837" />

        <Button
            android:id="@+id/btnLaunch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="▶ LAUNCH GAME"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="#0088FF" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="NEXT ▶"
            android:textColor="#EEEEEE"
            android:textStyle="bold"
            android:backgroundTint="#252837" />

    </LinearLayout>

</LinearLayout>
